# Dev: leave empty so the browser calls same-origin /v1/* (Vite proxies to the API).
VITE_API_BASE_URL=

# Backend target for Vite dev proxy only (not exposed to the browser bundle).
VITE_DEV_API_TARGET=http://127.0.0.1:3000

# Production / preview: point at API origin (local monolith or CloudFront /api prefix).
# VITE_API_BASE_URL=http://127.0.0.1:3000
# VITE_API_BASE_URL=https://your-distribution.example/api

# Dev-only: signs synthetic JWTs in the browser (same secret as SYNTHETIC_JWT_SECRET).
VITE_SYNTHETIC_JWT_SECRET=dev-only-change-me

# Default synthetic user UUID (fixture-safe; not real PII)
VITE_SYNTHETIC_USER_ID=11111111-1111-4111-8111-111111111111
