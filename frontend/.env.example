# Local API (OpenAPI server prefix /api on baseline or edge stack)
VITE_API_BASE_URL=http://127.0.0.1:3000/api

# Dev-only: signs synthetic JWTs in the browser (same secret as SYNTHETIC_JWT_SECRET).
# Never use a production secret or real user credentials here.
VITE_SYNTHETIC_JWT_SECRET=dev-only-change-me

# Optional default synthetic user UUID (fixture-safe; not real PII)
VITE_SYNTHETIC_USER_ID=11111111-1111-4111-8111-111111111111
