{
  "name": "railflux",
  "private": true,
  "version": "0.0.0",
  "description": "RailFlux experiment monorepo (implementation in progress)",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "validate:openapi": "./scripts/validate-openapi.sh",
    "verify:fixture": "node database/scripts/verify-fixture.mjs",
    "build:shared": "npm run build -w @railflux/shared",
    "build:baseline": "npm run build -w @railflux/baseline",
    "typecheck:shared": "npm run typecheck -w @railflux/shared",
    "typecheck:baseline": "npm run typecheck -w @railflux/baseline",
    "test": "npm run build:shared && node --test tests/*.test.mjs",
    "mint:jwt": "node scripts/mint-synthetic-jwt.mjs",
    "lint": "npm run validate:openapi && npm run verify:fixture && npm run typecheck:shared",
    "ci": "npm run lint && npm run build:shared && npm run typecheck:baseline && npm test",
    "db:up": "./scripts/db-up.sh",
    "db:load": "./database/scripts/load-fixture.sh",
    "db:bootstrap": "npm run db:up && npm run db:load"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
