NODE_ENV=development

SYNTHETIC_JWT_SECRET=dev-only-change-me

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=railflux
MYSQL_PASSWORD=railflux
MYSQL_DATABASE=railflux

SQS_ENDPOINT=http://127.0.0.1:9324
SQS_SIDE_EFFECTS_QUEUE_URL=http://127.0.0.1:9324/000000000000/railflux-side-effects
# Optional; set when inspecting DLQ depth locally
# SQS_SIDE_EFFECTS_DLQ_URL=http://127.0.0.1:9324/000000000000/railflux-side-effects-dlq
AWS_REGION=elasticmq-local

# Long-poll wait (seconds) per ReceiveMessage
WORKER_SQS_WAIT_SECONDS=5
