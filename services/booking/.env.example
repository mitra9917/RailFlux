NODE_ENV=development
PORT=3002
SERVICE_PROFILE=optimized

SYNTHETIC_JWT_SECRET=dev-only-change-me

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=railflux
MYSQL_PASSWORD=railflux
