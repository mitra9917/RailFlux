FROM node:20-bookworm-slim AS build
WORKDIR /repo
COPY package.json package-lock.json ./
COPY packages/shared ./packages/shared
COPY services/baseline ./services/baseline
COPY services/read ./services/read
COPY services/booking ./services/booking
COPY services/edge ./services/edge
COPY services/worker ./services/worker
ARG BUILD_SCRIPT="npm run build:shared && npm run build:baseline && npm run build -w @railflux/read"
RUN npm ci && sh -c "${BUILD_SCRIPT}"

FROM node:20-bookworm-slim
ARG SERVICE_PATH=services/read
ARG LISTEN_PORT=3001
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /repo/node_modules /app/node_modules
COPY --from=build /repo/packages/shared /app/packages/shared
COPY --from=build /repo/services/baseline /app/services/baseline
COPY --from=build /repo/services/read /app/services/read
COPY --from=build /repo/services/booking /app/services/booking
COPY --from=build /repo/services/edge /app/services/edge
COPY --from=build /repo/services/worker /app/services/worker
WORKDIR /app/${SERVICE_PATH}
ENV PORT=${LISTEN_PORT}
EXPOSE ${LISTEN_PORT}
HEALTHCHECK --interval=10s --timeout=5s --retries=6 --start-period=25s \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/health/ready').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/index.js"]
