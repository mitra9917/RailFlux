FROM node:20-bookworm-slim AS build
WORKDIR /repo
COPY package.json package-lock.json ./
COPY packages/shared ./packages/shared
COPY services/baseline ./services/baseline
RUN npm ci \
  && npm run build:shared \
  && npm run build -w @railflux/baseline

FROM node:20-bookworm-slim
WORKDIR /app/services/baseline
ENV NODE_ENV=production
COPY --from=build /repo/node_modules /app/node_modules
COPY --from=build /repo/packages/shared /app/packages/shared
COPY --from=build /repo/services/baseline /app/services/baseline
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --retries=6 --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:3000/health/ready').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/index.js"]
