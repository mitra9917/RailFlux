# Copy to .env in this directory (gitignored):
#   cp infrastructure/compose/.env.example infrastructure/compose/.env
#
# Baseline profile only. For optimized (read/booking/worker/edge), use:
#   cp infrastructure/compose/.env.optimized.example infrastructure/compose/.env
#
# With COMPOSE_PROFILES=baseline, `npm run compose:baseline` starts MySQL, loads the
# deterministic fixture once, and runs the baseline monolith API.

COMPOSE_PROFILES=baseline

# Baseline JWT signing (local synthetic tokens only)
SYNTHETIC_JWT_SECRET=dev-only-change-me

# Host port for baseline HTTP (container always listens on 3000)
BASELINE_HOST_PORT=3000
