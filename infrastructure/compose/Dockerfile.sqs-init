FROM node:20-bookworm-slim AS build
WORKDIR /repo
COPY package.json package-lock.json ./
COPY packages/shared ./packages/shared
COPY services/baseline ./services/baseline
COPY scripts/compose-sqs-init.mjs ./scripts/compose-sqs-init.mjs
RUN npm ci && npm run build:shared && npm run build -w @railflux/baseline

FROM node:20-bookworm-slim
WORKDIR /app
COPY --from=build /repo/node_modules /app/node_modules
COPY --from=build /repo/packages/shared /app/packages/shared
COPY --from=build /repo/services/baseline /app/services/baseline
COPY --from=build /repo/scripts/compose-sqs-init.mjs /app/scripts/compose-sqs-init.mjs
ENV SQS_ENDPOINT=http://elasticmq:9324
ENTRYPOINT ["node", "/app/scripts/compose-sqs-init.mjs"]
