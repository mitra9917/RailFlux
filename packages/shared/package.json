{
  "name": "@railflux/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared API types and error codes from OpenAPI v1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./synthetic-jwt": {
      "types": "./dist/synthetic-jwt.d.ts",
      "default": "./dist/synthetic-jwt.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "jose": "^6.2.12"
  }
}
